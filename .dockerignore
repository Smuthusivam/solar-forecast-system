# Keep build context small and avoid copying secrets / local state into images.
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Python venvs
venv/
.venv/
env/

# Node
frontend/node_modules/
frontend/dist/

# Local DB and uploads (volumes will hold these at runtime)
backend/storage/db/
backend/storage/uploads/
backend/storage/exports/
ml_core/saved_models/*.pkl
ml_core/saved_models/*.joblib

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Env files (NEVER bake secrets into images)
.env
.env.*
!.env.example

# Docs / misc
*.md
!README.md
