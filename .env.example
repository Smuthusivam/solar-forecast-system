# ──────────────────────────────────────────────────────────────
# Solar Irradiance Forecasting System — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ──────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────
APP_ENV=production
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# ─── Anthropic (Claude AI column detection) ───────────────────
# Required — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-replace-me

# ─── PostgreSQL (used by docker-compose to spin up the DB) ────
POSTGRES_USER=solar
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=solar_forecast
POSTGRES_PORT=5432

# ─── Database connection URLs ─────────────────────────────────
# Used by the backend at runtime.
# docker-compose sets this automatically from the POSTGRES_* vars above.
# For local dev outside Docker, set this to your local Postgres instance.
DATABASE_URL=postgresql://solar:change-this-strong-password@localhost:5432/solar_forecast

# Used by pytest — separate test DB so tests never touch real data.
TEST_DATABASE_URL=postgresql://solar:change-this-strong-password@localhost:5432/solar_forecast_test

# ─── Backend tuning ───────────────────────────────────────────
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_ECHO=false
BACKEND_PORT=8000

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_PORT=80
# Leave empty for same-origin (nginx proxies /api/* to backend).
VITE_API_BASE_URL=
