# ──────────────────────────────────────────────────────────────
# Solar Irradiance Forecasting System — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ──────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────
APP_ENV=production

# Comma-separated list of origins allowed to call the API.
# When using the bundled nginx frontend on port 80, the default below works.
# For a separate frontend domain, add it here.
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# ─── Anthropic (Claude AI column detection) ───────────────────
# Required — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-replace-me

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=solar
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=solar_forecast
POSTGRES_PORT=5432

# ─── Backend tuning ───────────────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
BACKEND_PORT=8000

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_PORT=80
# Leave empty for same-origin (nginx proxies /api/* to backend).
# Set to e.g. https://api.example.com only if backend is on a different host.
VITE_API_BASE_URL=
